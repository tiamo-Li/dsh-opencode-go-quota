{
  "name": "dsh-opencode-go-quota",
  "version": "0.1.0",
  "description": "Show OpenCode Go (5-hour rolling / weekly / monthly) quota usage in the DSH composer dock.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode-go",
    "quota",
    "usage"
  ],
  "license": "MIT",
  "author": "tiamo-Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiamo-Li/dsh-opencode-go-quota.git"
  },
  "homepage": "https://github.com/tiamo-Li/dsh-opencode-go-quota#readme",
  "bugs": {
    "url": "https://github.com/tiamo-Li/dsh-opencode-go-quota/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/host-unit.mjs && node test/client-smoke.mjs",
    "test:render": "node test/client-render.mjs",
    "test:all": "node test/host-unit.mjs && node test/client-smoke.mjs && node test/client-render.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
